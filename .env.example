# Base de données (en Docker Compose, l'hôte est "db")
DATABASE_URL=postgresql://recipes:recipes@localhost:5432/recipes
POSTGRES_PASSWORD=recipes

# Secret de signature des sessions : openssl rand -base64 32
SESSION_SECRET=change-me-with-at-least-32-characters

# Super admin créé au démarrage s'il n'existe pas encore
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-now
SUPERADMIN_NAME=Admin

# Agent d'import (API Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Stockage des photos
UPLOAD_DIR=./data/uploads
