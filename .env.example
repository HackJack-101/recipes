# Database (with Docker Compose, the host is "db")
DATABASE_URL=postgresql://recipes:recipes@localhost:5432/recipes
POSTGRES_PASSWORD=recipes

# Session signing secret: openssl rand -base64 32
SESSION_SECRET=change-me-with-at-least-32-characters

# Super admin created at startup if none exists yet
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-now
SUPERADMIN_NAME=Admin

# Import agent (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Photo storage
UPLOAD_DIR=./data/uploads
