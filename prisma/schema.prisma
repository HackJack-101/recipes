generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  MANUAL
  URL
  HTML
  TEXT
}

enum KitchenRole {
  OWNER
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean      @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  recipes      Recipe[]
}

model Kitchen {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  recipes     Recipe[]
  tags        Tag[]
}

model Membership {
  userId    String
  kitchenId String
  role      KitchenRole @default(MEMBER)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchen   Kitchen     @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@id([userId, kitchenId])
}

model Recipe {
  id          String        @id @default(cuid())
  kitchenId   String
  authorId    String
  title       String
  description String?
  // null = recipe without a guest count: the reader adapts the quantities
  servings    Int?
  prepMinutes Int?
  cookMinutes Int?
  // [{ quantity: number | null, unit: string | null, name: string }]
  ingredients Json
  // string[]
  steps       Json
  sourceType  SourceType    @default(MANUAL)
  sourceUrl   String?
  // non-null = recipe shared publicly at /r/<slug>
  publicSlug  String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  kitchen     Kitchen       @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id])
  photos      RecipePhoto[]
  tags        Tag[]

  @@index([kitchenId])
}

model Tag {
  id        String   @id @default(cuid())
  kitchenId String
  name      String
  kitchen   Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  recipes   Recipe[]

  @@unique([kitchenId, name])
}

model RecipePhoto {
  id        String   @id @default(cuid())
  recipeId  String
  filename  String
  mimeType  String
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}
